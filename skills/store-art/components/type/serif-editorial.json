{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.badge{display:inline-flex;align-items:center;gap:16px;background:var(--ink);color:var(--bg);border-radius:999px;padding:18px 40px;font-weight:800;font-size:40px;letter-spacing:.04em}.badge::before{content:'';width:18px;height:18px;border-radius:50%;background:var(--accent)}h1{font-family:'Noto Serif TC','Fraunces',serif;font-weight:900;font-size:var(--title);line-height:1.08;margin-top:48px;letter-spacing:-.01em}h1 em{font-style:normal;background:linear-gradient(transparent 62%,var(--accent) 62%)}p{font-size:54px;line-height:1.5;margin-top:40px;max-width:1000px;color:var(--muted,#4A463F);font-weight:400}" }
