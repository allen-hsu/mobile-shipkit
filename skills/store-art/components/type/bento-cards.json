{ "css": "body{font-family:'Inter','Noto Sans JP','Noto Sans TC',sans-serif}.badge{align-self:flex-start;background:linear-gradient(90deg,var(--accent),var(--accent2));padding:16px 36px;border-radius:999px;font-weight:800;font-size:36px;letter-spacing:.12em}h1{font-weight:900;font-size:var(--title);line-height:1.12;letter-spacing:-.02em}h1 em{font-style:normal;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;color:transparent}p{font-size:50px;color:var(--muted,#9AA4BF);font-weight:600}" }
