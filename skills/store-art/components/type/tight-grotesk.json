{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.copy{text-align:left}.badge{display:inline-block;font-weight:800;font-size:34px;background:var(--ink);color:var(--bg);padding:8px 22px;border-radius:10px;margin-bottom:24px}h1{font-weight:800;font-size:var(--title);line-height:1.0;letter-spacing:-.055em;color:var(--ink)}h1 em{font-style:normal;color:var(--accent)}p{font-size:46px;line-height:1.4;margin-top:28px;max-width:980px;color:var(--ink);opacity:.7;font-weight:600}.device.card{border-radius:48px;box-shadow:0 30px 60px rgba(0,0,0,.18)}" }
