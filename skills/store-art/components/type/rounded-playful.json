{ "css": "body{font-family:'Nunito','Noto Sans TC','Noto Sans JP',sans-serif}.copy{text-align:center}.badge{display:inline-block;background:#fff;color:var(--bg);border-radius:999px;padding:16px 40px;font-weight:900;font-size:40px;box-shadow:0 10px 0 #00000022}h1{font-weight:900;font-size:var(--title);line-height:1.04;margin-top:40px;letter-spacing:-.02em;text-shadow:0 8px 0 #00000022}h1 em{font-style:normal;color:var(--accent)}p{font-size:52px;line-height:1.4;margin:34px auto 0;max-width:960px;font-weight:800;opacity:.92}" }
