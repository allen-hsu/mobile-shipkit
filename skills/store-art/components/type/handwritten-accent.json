{ "css": "body{font-family:'Nunito','Noto Sans TC','Noto Sans JP',sans-serif}.badge{display:inline-block;font-family:'Caveat',cursive;font-size:64px;font-weight:700;color:var(--accent);transform:rotate(-3deg)}h1{font-weight:900;font-size:var(--title);line-height:1.06;margin-top:20px;letter-spacing:-.02em}h1 em{font-style:normal;background:var(--accent2);padding:0 14px;border-radius:14px;box-decoration-break:clone;-webkit-box-decoration-break:clone}p{font-size:52px;line-height:1.45;margin-top:36px;max-width:1000px;color:var(--muted,#6B5B4D);font-weight:700}" }
