{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.badge{display:inline-flex;align-items:center;gap:14px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:32px;letter-spacing:.08em;color:var(--muted,#A1A1AA);border:1px solid #ffffff2e;border-radius:10px;padding:12px 24px}.badge::before{content:'';width:14px;height:14px;border-radius:50%;background:var(--accent2);box-shadow:0 0 18px var(--accent2)}h1{font-weight:700;font-size:var(--title);line-height:1.04;margin-top:40px;letter-spacing:-.035em}h1 em{font-style:normal;background:linear-gradient(90deg,#fff,var(--accent));-webkit-background-clip:text;color:transparent}p{font-size:48px;line-height:1.45;margin-top:32px;max-width:980px;color:var(--muted,#A1A1AA);font-weight:400}" }
