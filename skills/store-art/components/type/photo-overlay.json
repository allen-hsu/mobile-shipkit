{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.badge{display:inline-block;background:#ffffff26;border:1px solid #ffffff55;backdrop-filter:blur(12px);border-radius:999px;padding:14px 32px;font-weight:700;font-size:36px;letter-spacing:.1em;text-transform:uppercase}h1{font-weight:800;font-size:var(--title);line-height:1.06;margin-top:40px;letter-spacing:-.025em;text-shadow:0 6px 30px #00000080}h1 em{font-style:normal;color:var(--accent)}p{font-size:50px;line-height:1.45;margin-top:34px;max-width:980px;color:var(--muted,#E6E1D8);font-weight:500;text-shadow:0 4px 18px #00000080}" }
