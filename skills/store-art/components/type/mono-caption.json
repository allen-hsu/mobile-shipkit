{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.copy{text-align:center}.badge{display:inline-block;font-family:'JetBrains Mono',monospace;color:var(--accent);font-size:34px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:32px}h1{font-weight:700;font-size:var(--title);line-height:1.08;letter-spacing:-.03em}h1 em{font-style:normal;color:var(--accent)}p{font-family:'JetBrains Mono',monospace;font-size:40px;line-height:1.5;margin:36px auto 0;max-width:960px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.el-text,.el-features,.el-stat .v,.el-stamp .v{font-family:'JetBrains Mono',monospace!important;text-transform:uppercase;letter-spacing:.06em}.el-features{font-size:34px;font-weight:500;gap:70px 60px}.el-features>div{flex-direction:column;text-align:center;gap:24px}.el-features .ic{background:transparent;border:0;font-size:72px}" }
