{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.badge{display:inline-block;background:#ffffff22;border:2px solid #ffffff40;border-radius:999px;padding:14px 34px;font-weight:700;font-size:36px;letter-spacing:.08em}h1{font-weight:900;font-size:var(--title);line-height:1.08;margin-top:40px;letter-spacing:-.02em}h1 em{font-style:normal;background:linear-gradient(90deg,#fff,var(--accent2));-webkit-background-clip:text;color:transparent}p{font-size:50px;line-height:1.45;margin-top:36px;max-width:1000px;color:var(--muted,#E9D5FF);font-weight:500}" }
