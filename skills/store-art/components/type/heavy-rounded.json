{ "css": "body{font-family:'Nunito','Manrope','Noto Sans TC','Noto Sans JP',sans-serif}.copy{text-align:center}.badge{display:inline-block;font-weight:900;font-size:34px;letter-spacing:.04em;background:var(--accent);color:#fff;padding:10px 26px;border-radius:999px;margin-bottom:24px}h1{font-weight:900;font-size:var(--title);line-height:1.05;letter-spacing:-.03em;color:var(--ink)}h1 em{font-style:normal;color:var(--accent)}p{font-size:46px;line-height:1.4;margin:28px auto 0;max-width:960px;font-weight:700;color:var(--muted)}" }
