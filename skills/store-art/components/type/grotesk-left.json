{ "css": "body{font-family:'Inter','Noto Sans TC','Noto Sans JP',sans-serif}.copy{text-align:left}.badge{display:inline-block;font-weight:700;font-size:34px;letter-spacing:.02em;border:3px solid var(--ink);border-radius:999px;padding:10px 26px;margin-bottom:28px}h1{font-weight:600;font-size:var(--title);line-height:1.0;letter-spacing:-.045em}h1 em{font-style:normal;text-decoration:underline;text-decoration-thickness:8px;text-underline-offset:14px}p{font-size:50px;line-height:1.35;margin-top:30px;max-width:1000px;font-weight:500;opacity:.85}" }
