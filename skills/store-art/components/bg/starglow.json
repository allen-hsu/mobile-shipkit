{ "css": "body{background:radial-gradient(ellipse 80% 50% at 50% 100%,var(--bg2,#5B1B63) 0%,var(--bg) 70%)}.sg-stars{position:absolute;inset:0;z-index:0;background-image:radial-gradient(#fff 1.4px,transparent 1.8px),radial-gradient(#fff 1px,transparent 1.3px);background-size:280px 280px,160px 160px;background-position:40px 60px,110px 140px;opacity:.35}.sg-glow{position:absolute;z-index:0;width:1200px;height:1200px;border-radius:50%;left:50%;top:30%;transform:translate(-50%,-50%);background:radial-gradient(circle,color-mix(in srgb,var(--accent) 45%,transparent),transparent 60%)}",
  "html": "<div class=\"sg-stars\"></div><div class=\"sg-glow\"></div>" }
