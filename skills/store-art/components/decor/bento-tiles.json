{ "css": ".tiles{position:absolute;left:96px;right:96px;bottom:96px;height:340px;display:grid;grid-template-columns:repeat(3,1fr);gap:36px;z-index:3}.tile{background:var(--card,#161B2Ccc);border:2px solid var(--card-border,#ffffff14);border-radius:56px;backdrop-filter:blur(20px);display:flex;flex-direction:column;justify-content:center;gap:12px;padding:48px}.tile .k{font-size:92px;font-weight:900;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;color:transparent}.tile .v{font-size:34px;color:var(--muted,#9AA4BF);font-weight:600}" }
