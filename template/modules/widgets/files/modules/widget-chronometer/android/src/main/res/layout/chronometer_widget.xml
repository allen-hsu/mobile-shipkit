<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
  android:padding="16dp" android:gravity="center_vertical" android:background="@android:color/white">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="12sp" android:textColor="#6B7280" android:maxLines="1" android:ellipsize="end" />
  <!-- The system ticks this every second; no updates from the app are needed. -->
  <Chronometer android:id="@+id/timer" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="32sp" android:textStyle="bold" android:textColor="#111111" android:countDown="true" android:format="%s" />
</LinearLayout>
